{
  "appId": "com.immoexpress.app",
  "appName": "ImmoExpress",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#2563eb",
      "androidSplashResourceName": "splash"
    }
  }
}